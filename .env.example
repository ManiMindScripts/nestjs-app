# App
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database (Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=my_app
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Bootstrap admin (seeded on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin

# JWT
JWT_ACCESS_SECRET=replace-with-a-random-32+char-secret-000000
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Refresh-token cookie (secure is auto-derived from NODE_ENV)
JWT_COOKIE_NAME=refresh_token
JWT_COOKIE_PATH=
JWT_COOKIE_SAME_SITE=lax
PASSWORD_RESET_TOKEN_TTL=30m

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Throttler (rate limiting)
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Reverse-proxy hops in front of the app, so req.ip (and therefore rate-limit
# buckets) resolve to the real client. Set this to the EXACT number of
# proxies/load balancers verified against actual infra - not a guess. A value
# that is too permissive lets clients forge X-Forwarded-For and get a fresh
# rate-limit bucket on every request. Accepts a hop count ("1") or a
# comma-separated list of trusted proxy IPs/CIDRs. Leave unset when the app is
# exposed directly.
# TRUST_PROXY=1

# Real-time (Socket.IO)
# Max socket connections per IP per 60s window (0 disables the check)
WS_CONNECT_RATE_LIMIT=20

# Logging
LOG_LEVEL=info

# Swagger (default: enabled in non-production, disabled in production)
SWAGGER_ENABLED=true