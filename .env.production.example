# ============================================================================
# PRODUCTION ENVIRONMENT TEMPLATE
#
# Copy this file to an IGNORED file named `.env.production` on the host and
# fill in the real values. NEVER commit real secrets - `.env.production` is
# git-ignored and excluded from Docker build contexts via `.dockerignore`.
#
# Managed AWS services referenced here (Stage 2 Terraform will provision):
#   - DB_HOST/DB_PORT : Amazon RDS PostgreSQL (private subnet)
#   - REDIS_HOST/PORT : Amazon ElastiCache Redis (private subnet)
#   - MAIL_*          : Amazon SES SMTP (IAM SMTP credentials)
# Secrets are fetched at deploy time from AWS SSM Parameter Store (see
# deploy.sh) rather than living on disk in plaintext.
# ============================================================================

# App
NODE_ENV=production
PORT=3000
API_PREFIX=api
# Comma-separated origins that may call the API (must exactly match the
# deployed frontend, e.g. https://app.example.com).
CORS_ORIGIN=https://app.example.com
FRONTEND_URL=https://app.example.com

# Database (Amazon RDS PostgreSQL - host is the RDS endpoint, port 5432)
DB_HOST=my-app-db.cluster-XXXXXXXXXXXX.region.rds.amazonaws.com
DB_PORT=5432
DB_USERNAME=prod_app_user
DB_PASSWORD=CHANGE_ME_FROM_SSM
DB_NAME=my_app
# NEVER enable synchronize in production - schema is owned by migrations.
DB_SYNCHRONIZE=false
# Keep off in production: SQL (incl. parameters) would leak to container logs.
DB_LOGGING=false

# Bootstrap admin (seeded on first run - rotate immediately after deploy)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_FROM_SSM

# JWT (rotate periodically; >= 32 chars; source from SSM in a real deploy)
JWT_ACCESS_SECRET=CHANGE_ME_FROM_SSM_32+
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_COOKIE_NAME=refresh_token
JWT_COOKIE_PATH=
# Secure cookie is derived from NODE_ENV=production automatically.
JWT_COOKIE_SAME_SITE=lax
PASSWORD_RESET_TOKEN_TTL=30m

# Mail (Amazon SES via SMTP port 587 STARTTLS - MAIL_SECURE must be false)
MAIL_DRIVER=smtp
MAIL_HOST=email-smtp.region.amazonaws.com
MAIL_PORT=587
MAIL_SECURE=false
# SES SMTP IAM user credentials (from Secrets Manager / SSM, NOT committed).
MAIL_USER=CHANGE_ME_FROM_SSM
MAIL_PASS=CHANGE_ME_FROM_SSM
MAIL_FROM="My App <no-reply@verified-domain.example.com>"

# Alerting sink for permanently-failed background jobs (Slack webhook URL).
ALERT_SLACK_WEBHOOK_URL=

# Redis (Amazon ElastiCache - endpoint, port 6379; password for auth token)
REDIS_HOST=my-app-redis.XXXXXXXXXX.region.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=

# Throttler (rate limiting)
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Public ALB terminates TLS, so the app sees one proxy hop before the client:
# set to the EXACT number of verified proxies, i.e. "1" for a single ALB.
TRUST_PROXY=1

# Real-time (Socket.IO)
WS_CONNECT_RATE_LIMIT=20

# Logging
LOG_LEVEL=info

# Swagger
SWAGGER_ENABLED=false

# Observability: in-memory metrics + 5xx error-rate alerting.
METRICS_ENABLED=true
METRICS_ERROR_RATE_THRESHOLD=0.1
METRICS_WINDOW_MS=300000
METRICS_MIN_SAMPLES=20
METRICS_ALERT_COOLDOWN_MS=300000


MIGRATE_ON_START=true
SEED_ON_START=true
